MONGO_URL=mongodb://localhost:27017/???
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here

# JWT Authentication
IDENTITY_SERVICE_URL=http://localhost:5001
JWKS_TTL_IN_MINUTES=10

# RabbitMQ Toggle
RABBITMQ_ENABLED=true

# A12 RabbitMQ Queue Names
A12A_REQUEST_QUEUE=telcenter_partner_s09_a12a_requests
A12A_RESPONSE_QUEUE=telcenter_partner_s09_a12a_responses
A12B_EVENT_QUEUE=telcenter_partner_s17_core_update_events

# A12 Consumer Configuration
A12_CONSUMER_THREADS=2
